{
   "include": [
     "$HOME/.config/waybar/Modules",
     "$HOME/.config/waybar/ModulesCustom",
     ],

    "layer": "top",
    "position": "top",
    "margin-top": 5,
    "width": 1900,
    "modules-left": ["group/main", "hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": [ "custom/update", "network", "pulseaudio", "hyprland/language", "custom/power"  ],
    "sway/window": {
        "max-length": 50
    },
    
 
}

